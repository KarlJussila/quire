  "effects": [
    {
      "type": "change",
      "of": "event",
      "set": {
        "total": {
          "$add": "modifiers.{ability}"
        }
      },
      "when": {
        "event": "event:roll-made",
        "by": "self",
        "match": {
          "roll": "roll:check",
          "ability": true
        }
      }
    },
    {
      "type": "change",
      "of": "event",
      "set": {
        "total": {
          "$add": {
            "divide": {
              "times": {
                "max": [
                  "proficiencies.{skill}",
                  "proficiencies.group:ability-checks"
                ]
              },
              "by": "proficiencyBonus"
            },
            "by": 1,
            "round": "down"
          }
        }
      },
      "when": {
        "event": "event:roll-made",
        "by": "self",
        "match": {
          "roll": "roll:check"
        }
      }
    }
  ]
