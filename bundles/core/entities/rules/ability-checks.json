{
  "id": "rule:ability-checks",
  "name": "Ability Checks",
  "source": {
    "book": "core"
  },
  "text": {
    "plain": "An activity that calls for an ability check has each target make it, or the creature using the activity when the check is its own; a contest has both sides roll. An ability check adds the modifier of its ability, and the proficiency bonus as many times as the creature's proficiency in the check's skill counts it: half, once, or twice."
  },
  "group": "group:combat",
  "appliesTo": {
    "pool": "any"
  },
  "emits": [
    {
      "event": "event:roll-made",
      "for": {
        "kind": "activity",
        "where": {
          "all": [
            {
              "match": {
                "delivery": {
                  "check": true
                }
              }
            },
            {
              "not": {
                "match": {
                  "delivery": {
                    "check": {
                      "by": "self"
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "at": "rolled",
      "by": "target",
      "subject": "self",
      "fields": {
        "roll": "roll:check",
        "attack": {
          "settled": "attack"
        },
        "spell": {
          "settled": "spell"
        },
        "slot": {
          "settled": "slot"
        },
        "natural": {
          "settled": "natural"
        },
        "total": {
          "settled": "total"
        },
        "mode": {
          "settled": "mode"
        }
      }
    },
    {
      "event": "event:roll-resolved",
      "for": {
        "kind": "activity",
        "where": {
          "all": [
            {
              "match": {
