{
  "id": "rule:damage-and-healing",
  "name": "Damage and Healing",
  "source": {
    "book": "core"
  },
  "text": {
    "plain": "Damage rolls its dice, can be changed as it is about to be dealt, and then reduces hit points; healing rolls its dice and restores them. A creature can be killed, and some magic brings it back."
  },
  "group": "group:combat",
  "appliesTo": {
    "pool": "any"
  },
