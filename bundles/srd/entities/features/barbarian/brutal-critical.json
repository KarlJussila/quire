{
  "id": "feature:barbarian/brutal-critical",
  "name": "Brutal Critical",
  "source": {
    "book": "srd"
  },
  "text": {
    "formatted": "Beginning at 9th level, you can roll one additional weapon damage die when determining the extra damage for a critical hit with a melee attack.\n\nThis increases to two additional dice at 13th level and three additional dice at 17th level.",
    "plain": "Beginning at 9th level, you can roll one additional weapon damage die when determining the extra damage for a critical hit with a melee attack.\n\nThis increases to two additional dice at 13th level and three additional dice at 17th level.",
    "wording": "srd"
  },
  "effects": [
    {
      "type": "die-mod",
      "extraDie": true,
      "when": {
        "event": "event:roll-made",
        "by": "self",
        "match": {
          "roll": "roll:damage",
          "attack": {
            "range": "melee",
            "via": "weapon"
          },
          "crit": true
        }
      }
    },
    {
      "type": "die-mod",
      "extraDie": true,
      "when": {
        "all": [
          {
            "event": "event:roll-made",
            "by": "self",
            "match": {
              "roll": "roll:damage",
              "attack": {
                "range": "melee",
                "via": "weapon"
              },
              "crit": true
            }
          },
          {
            "compare": "levels.class:barbarian",
            "atLeast": 13
          }
        ]
      }
    },
    {
      "type": "die-mod",
      "extraDie": true,
      "when": {
