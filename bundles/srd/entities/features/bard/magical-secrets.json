{
  "id": "feature:bard/magical-secrets",
  "name": "Magical Secrets",
  "source": {
    "book": "srd"
  },
  "text": {
    "formatted": "By 10th level, you have plundered magical knowledge from a wide spectrum of disciplines. Choose two spells from any class, including this one. A spell you choose must be of a level you can cast, as shown on the Bard table, or a cantrip.\n\nThe chosen spells count as bard spells for you and are included in the number in the Spells Known column of the Bard table.\n\nYou learn two additional spells from any class at 14th level and again at 18th level.",
    "plain": "By 10th level, you have plundered magical knowledge from a wide spectrum of disciplines. Choose two spells from any class, including this one. A spell you choose must be of a level you can cast, as shown on the Bard table, or a cantrip.\n\nThe chosen spells count as bard spells for you and are included in the number in the Spells Known column of the Bard table.\n\nYou learn two additional spells from any class at 14th level and again at 18th level.",
    "wording": "srd"
  },
  "effects": [
    {
      "type": "change",
      "set": {
        "spellcasting": {
          "class:bard": {
            "known": {
              "$add": {
                "byLevel": {
                  "10": -2,
                  "14": -4,
                  "18": -6
                },
                "of": "class:bard"
              }
            }
          }
        }
      }
    },
    {
      "type": "record",
      "pick": {
        "choose": {
          "key": "magical-secrets-10",
          "name": "Magical Secrets (10)",
          "count": 2,
          "from": [
            {
              "kind": "spell",
              "where": {
                "match": {
                  "level": {
                    "atMost": "spellcasting.class:bard.spellLevel"
                  },
                  "lists": true
                }
              }
            }
          ]
        }
      },
      "when": {
        "compare": "levels.class:bard",
        "atLeast": 10
      }
    },
    {
      "type": "spell-access",
      "spells": {
        "chosen": "magical-secrets-10"
      },
      "how": "known",
      "when": {
        "compare": "levels.class:bard",
        "atLeast": 10
      }
    },
    {
      "type": "record",
      "pick": {
        "choose": {
          "key": "magical-secrets-14",
          "name": "Magical Secrets (14)",
          "count": 2,
          "from": [
            {
              "kind": "spell",
              "where": {
                "match": {
                  "level": {
                    "atMost": "spellcasting.class:bard.spellLevel"
                  },
                  "lists": true
                }
              }
            }
          ]
        }
      },
      "when": {
        "compare": "levels.class:bard",
        "atLeast": 14
      }
    },
    {
      "type": "spell-access",
      "spells": {
        "chosen": "magical-secrets-14"
      },
      "how": "known",
      "when": {
        "compare": "levels.class:bard",
        "atLeast": 14
      }
    },
    {
      "type": "record",
      "pick": {
        "choose": {
          "key": "magical-secrets-18",
          "name": "Magical Secrets (18)",
          "count": 2,
          "from": [
            {
              "kind": "spell",
              "where": {
                "match": {
