                  },
                  "lists": true
                }
              }
            }
          ]
        }
      },
      "when": {
        "compare": "levels.class:bard",
        "atLeast": 18
      }
    },
    {
      "type": "spell-access",
      "spells": {
        "chosen": "magical-secrets-18"
      },
      "how": "known",
      "when": {
        "compare": "levels.class:bard",
        "atLeast": 18
      }
    }
  ],
  "gaps": []
