{
  "id": "feature:wizard/school-of-evocation/empowered-evocation",
  "name": "Empowered Evocation",
  "source": {
    "book": "srd"
  },
  "text": {
    "formatted": "Beginning at 10th level, you can add your Intelligence modifier to one damage roll of any wizard evocation spell you cast.",
    "plain": "Beginning at 10th level, you can add your Intelligence modifier to one damage roll of any wizard evocation spell you cast.",
    "wording": "srd"
  },
  "effects": [
    {
      "type": "change",
      "of": "event",
      "set": {
        "total": {
          "$add": "modifiers.ability:int"
        }
      },
      "when": {
        "all": [
          {
            "event": "event:roll-made",
            "by": "self",
            "match": {
              "roll": "roll:damage"
            }
          },
          {
            "spell": {
              "kind": "spell",
              "where": {
                "match": {
                  "school": "spell-school:evocation",
                  "lists": "class:wizard"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
