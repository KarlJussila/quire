        "who": {
          "pool": "any",
          "where": {
            "has": "condition:grappled",
            "source": "self"
          }
        }
      },
      "delivery": {
        "contest": {
          "self": {
            "ability": "ability:str",
            "skill": "skill:athletics"
          },
          "target": {
            "choose": {
              "key": "check",
              "name": "Which Check",
              "from": [
                {
                  "ability": "ability:str",
                  "skill": "skill:athletics"
                },
                {
                  "ability": "ability:dex",
                  "skill": "skill:acrobatics"
                }
              ]
            }
          }
        }
      },
      "outcomes": [
