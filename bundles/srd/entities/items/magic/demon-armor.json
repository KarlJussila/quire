  "gaps": [
    {
      "category": "item-mechanics",
      "name": "While cursed, the armor can’t be doffed, and no restriction names doffing a worn item."
    },
    {
      "category": "item-mechanics",
      "name": "The book does not define which other magic is “similar magic” and ends this curse."
    },
    {
      "category": "effect-model",
      "name": "The clawed gauntlets make the unarmed strikes weapons themselves, and counts-as has no purpose for an attack counting as a weapon."
    },
    {
      "category": "language",
      "name": "The armor grants understanding and speaking Abyssal only, and a proficiency in a language has no speak or read split."
