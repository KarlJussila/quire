{
  "id": "item:spellguard-shield",
  "name": "Spellguard Shield",
  "source": {
    "book": "srd"
  },
  "text": {
    "formatted": "While holding this shield, you have advantage on saving throws against spells and other magical effects, and spell attacks have disadvantage against you.",
    "plain": "While holding this shield, you have advantage on saving throws against spells and other magical effects, and spell attacks have disadvantage against you.",
    "wording": "srd"
  },
  "group": "group:armor",
  "rarity": "rarity:very-rare",
  "attunement": true,
  "base": "item:shield",
  "effects": [
    {
      "type": "roll-mod",
      "mode": "advantage",
      "when": {
        "all": [
          {
            "event": "event:roll-made",
            "by": "self",
            "match": {
              "roll": "roll:save",
              "against": {
                "sourceType": "source-type:magic"
              }
            }
          },
          {
            "has": "this",
            "match": {
              "attuned": true,
              "held": true
            }
          }
        ]
      }
    },
    {
      "type": "roll-mod",
      "mode": "disadvantage",
      "when": {
        "all": [
          {
            "event": "event:roll-made",
            "by": {
              "pool": "any"
            },
            "subject": "self",
            "match": {
              "roll": "roll:attack",
              "attack": {
                "via": "spell"
              }
            }
          },
          {
            "has": "this",
            "match": {
              "attuned": true,
              "held": true
            }
          }
        ]
      }
    }
  ]
}
