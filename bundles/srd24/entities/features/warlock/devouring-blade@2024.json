{
  "id": "feature:warlock/devouring-blade@2024",
  "name": "Devouring Blade",
  "source": {
    "book": "srd24"
  },
  "text": {
    "formatted": "_Prerequisite: Level 12+ Warlock, Thirsting Blade Invocation_\n\nThe Extra Attack of your Thirsting Blade invocation confers two extra attacks rather than one.",
    "plain": "Prerequisite: Level 12+ Warlock, Thirsting Blade Invocation\n\nThe Extra Attack of your Thirsting Blade invocation confers two extra attacks rather than one.",
    "wording": "srd"
  },
  "group": "group:eldritch-invocation",
  "requires": {
    "all": [
      {
        "compare": "levels.class:warlock",
        "atLeast": 12
      },
      {
        "has": "feature:warlock/thirsting-blade"
      }
    ]
  },
  "gaps": [
    {
      "category": "content-dependency",
      "name": "Pact of the Blade must apply the sourced pact-weapon marker to the actual bonded weapon; the three-attack variant already filters for that marker."
    }
  ],
  "effects": [
    {
      "type": "change",
      "of": "feature:warlock/thirsting-blade",
      "set": {
        "activities": {
          "thirsting-blade-attack": {
            "outcomes": {
              "$replace": [
                {
                  "runs": [
                    {
                      "activity": {
                        "kind": "activity",
                        "where": {
                          "match": {
                            "delivery": {
                              "attack": {
                                "via": "weapon",
                                "item": {
                                  "kind": "item",
                                  "where": {
                                    "has": "state:warlock/pact-weapon",
                                    "source": "self"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "times": 3
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
