    "wording": "srd"
  },
  "activities": [
    {
      "key": "superior-inspiration",
      "name": "Superior Inspiration",
      "trigger": {
        "event": "event:roll-made",
        "by": "self",
        "match": {
          "roll": "roll:initiative"
        }
      },
      "outcomes": [
        {
          "pool": {
            "resource": "bardic-inspiration",
            "add": {
              "max": [
                0,
                {
                  "sum": [
                    2,
                    {
                      "times": "pools.bardic-inspiration.current",
                      "by": -1
                    }
                  ]
                }
              ]
            }
          },
          "to": "self"
        }
      ]
    }
  ]
