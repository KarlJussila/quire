{
  "id": "feature:bard/superior-inspiration@2024",
  "name": "Level 18: Superior Inspiration",
  "source": {
    "book": "srd24"
  },
  "text": {
    "formatted": "When you roll Initiative, you regain expended uses of Bardic Inspiration until you have two if you have fewer than that.",
